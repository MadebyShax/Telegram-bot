# ===== Telegram bot (Python, app.py) =====

# Telegram Bot token from @BotFather (required)
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"

# PostgreSQL / Supabase with asyncpg
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_bot"

# Telegram Native Payment Tokens (@BotFather -> Payments -> Click / Payme)
CLICK_PROVIDER_TOKEN="398061629:TEST:999999"
PAYME_PROVIDER_TOKEN="371317599:TEST:999999"

# Google AI Studio API key (https://aistudio.google.com/app/apikey)
# Also used by the AI Studio web preview below.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
IMAGE_GEN_CONCURRENCY=2

# Pricing (UZS): one purchase = 1 package = CARDS_PER_PACKAGE cards
PACKAGE_PRICE_UZS=15000
CARDS_PER_PACKAGE=5
FREE_TRIAL_CREDITS=1

# ===== AI Studio web preview (server.ts / src) =====

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
